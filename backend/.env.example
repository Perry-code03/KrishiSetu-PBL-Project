# KrishiSetu Environment Configuration Template
# Copy this file to .env and fill in real values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=krishisetu
DB_USER=krishisetu_app
DB_PASSWORD=your_strong_db_password_here
JWT_SECRET=your_base64_random_jwt_secret_min_64_bytes
JWT_EXPIRATION_HOURS=24
SERVER_PORT=8080
ADMIN_EMAIL=admin@krishisetu.in
ADMIN_MOBILE=9876543210
ADMIN_PASSWORD=your_admin_seed_password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,https://krishi-setu-pbl-project.vercel.app
